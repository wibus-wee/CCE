[Unit]
Description=CCE repository context daemon
After=network-online.target

[Service]
Type=simple
User=cce
Group=cce
WorkingDirectory=/srv/repository
ExecStart=/usr/local/bin/cce-daemon /srv/repository --data-dir /var/lib/cce --web-root /usr/share/cce/web
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cce
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target

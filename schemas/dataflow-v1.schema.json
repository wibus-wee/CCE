{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wibus-wee/CCE/schemas/dataflow-v1.schema.json",
  "title": "CCE source-aligned dataflow artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repositoryId",
    "workspaceOverlayHash",
    "generator",
    "files",
    "nodes",
    "edges"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repositoryId": { "type": "string", "minLength": 1 },
    "workspaceOverlayHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "baseRevision": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "contentHash"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "name", "address"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "address": { "$ref": "#/$defs/address" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sourceNodeId", "targetNodeId", "kind"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "sourceNodeId": { "type": "string", "minLength": 1 },
          "targetNodeId": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": ["data_flow", "taint_flow", "control_flow"]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": {
            "type": "array",
            "items": { "$ref": "#/$defs/address" }
          }
        }
      }
    }
  },
  "$defs": {
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "startByte", "endByte", "startLine", "endLine"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "startByte": { "type": "integer", "minimum": 0 },
        "endByte": { "type": "integer", "minimum": 0 },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
